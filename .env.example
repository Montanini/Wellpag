# Variaveis de ambiente para producao (docker-compose.prod.yml).
# Copie este arquivo para ".env" na raiz do repo e preencha com valores
# reais antes de rodar:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
# NUNCA commitar o ".env" (ja esta no .gitignore da raiz).

# Segredo JWT compartilhado pelos 7 microsservicos em producao (min 256 bits).
# Gere com: openssl rand -base64 64
JWT_SECRET=

# Usuario/senha root do MongoDB em producao (habilita autenticacao no
# container mongodb) — nao usar os mesmos valores fake do application-dev.yml.
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=

# Credenciais OAuth2 do Google Cloud Console, usadas pelo auth-service
# (mesmas em todos os profiles — dev/teste/prod).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL publica do frontend em producao, usada pelo auth-service para redirect
# apos o login OAuth2 (ex.: https://app.seudominio.com).
FRONTEND_URL=

# Evolution API (WhatsApp), usada pelo notificacao-service para enviar
# lembretes e confirmacoes de pagamento. A URL nao precisa de variavel —
# em producao o notificacao-service chama o container evolution-api pelo
# hostname interno do Compose (http://evolution-api:8080), fixo no
# docker-compose.prod.yml. So a chave de API muda por ambiente:
# EVOLUTION_API_KEY: mesma chave configurada em AUTHENTICATION_API_KEY do
#   container evolution-api — nao usar a chave fake "wellpag-local-key" do dev.
EVOLUTION_API_KEY=
